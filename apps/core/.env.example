# Dost listens on the local network. Do not publish this port to the internet
# until authentication exists. Clients talk to Dost, never to Ollama directly.
HOST=0.0.0.0
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true

# Works with localhost or another machine on the LAN, for example http://192.168.1.20:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TEMPERATURE=0.2

# Leave empty until you exercise the voice pipeline.
SARVAM_API_KEY=

# auto = adaptive language detection (English, Hindi, Gujarati, Hinglish, ...)
SARVAM_STT_LANGUAGE=auto
SARVAM_STT_MODEL=saaras:v3-realtime
SARVAM_STT_MODE=transcribe
SARVAM_STT_STREAM_TYPE=balanced
# manual matches the client audio.start / audio.stop events.
# Use vad if the client streams continuously and wants server-side endpointing.
SARVAM_STT_ENDPOINTING=manual

SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TTS_SAMPLE_RATE=24000
SARVAM_TTS_CODEC=mp3

# memory = in-process store, useful before MongoDB is running.
# mongodb = the intended persistence. Set MONGODB_URI as well.
MEMORY_DRIVER=memory
MONGODB_URI=mongodb://127.0.0.1:27017/dost
HISTORY_MESSAGE_LIMIT=40

USER_TIMEZONE=Asia/Kolkata
AGENT_TIMEOUT_MS=120000

MCP_CONFIG_PATH=./config/mcp.servers.example.json
ENABLE_DEV_CLIENT=true

# Vision (Camera mode)
VISION_PROVIDER=ollama
VISION_MODEL=gemma4:latest
VISION_MAX_IMAGE_BYTES=5242880

# Self-signed TLS for local-network access (voice requires HTTPS).
# Run:  ./scripts/generate-cert.sh
# TLS_CERT=.certs/cert.pem
# TLS_KEY=.certs/key.pem
