{
  "servers": [
    {
      "id": "zoho-calendar",
      "enabled": false,
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-remote", "YOUR_ZOHO_MCP_URL", "--transport", "http-only"]
    },
    {
      "id": "device-service",
      "enabled": false,
      "transport": "http",
      "url": "http://127.0.0.1:4001/mcp",
      "headers": {}
    }
  ]
}
